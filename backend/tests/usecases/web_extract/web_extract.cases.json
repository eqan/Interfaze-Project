      "assertions": {"type": "extract"}
    },
    {
      "name": "amazon_catalog_deeper_prompt_fetches_html",
      "description": "Catalog name and price still fetch HTML when the prompt asks for reviews",
      "layer": "service",
      "input": {
        "url": "amazon",
        "prompt": "Extract product name, price, and customer reviews",
