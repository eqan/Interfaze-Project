    },
    {
      "name": "refine_pass_filters_nav_candidates",
      "description": "Refine pass keeps a known project and the profile name",
      "layer": "service",
      "input": {
        "url": "https://eqanahmad.com",
        "prompt": "What is full name of the profile and a project",
        "html": "portfolio",
        "uuid": "request-refine",
        "use_refine": true,
        "refine_from_candidates": true,
        "commands": [
          {"name": "profileName", "selector": "h3.about-name", "attr": "text", "many": false},
