{
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "reload": false,
    "workers": 4,
    "timeout_keep_alive": 120
  },
  "cors": {
    "allow_origins": [
      "*"
    ],
    "allow_credentials": true,
    "allow_methods": [
      "OPTIONS",
      "GET",
      "POST",
      "PUT",
      "PATCH",
      "DELETE"
    ],
    "allow_headers": [
      "*"
    ]
  },
  "rate_limits": {
    "chatbot": "5/second",
    "chatbot_stream": "5/second",
    "ingestion_scrape": "5/minute",
    "ingestion_search": "5/second",
    "interfaze_extract": "5/minute",
    "web_extract": "5/minute",
    "ticket": "5/second",
    "stats": "5/second"
  },
  "cache": {
    "backend": "memory",
    "namespace": "interfaze",
    "default_ttl_seconds": 300,
    "search_ttl_seconds": 180,
    "redis_url": ""
  },
  "features": {
    "enable_sentry": true,
    "enable_scheduler": true,
    "enable_stats": true,
    "enable_ticketing": true,
    "enable_ingestion": true,
    "enable_interfaze": true,
    "enable_web_extract": true,
    "enable_google_search_grounding": true
  },
  "database_pool": {
    "pool_size": 10,
    "max_overflow": 20,
    "pool_timeout": 30,
    "pool_recycle": 1800,
    "connect_timeout": 10,
    "keepalives": 1,
    "keepalives_idle": 60,
    "keepalives_interval": 10,
    "keepalives_count": 5
  },
  "ai": {
    "temperature": 1,
    "top_p": 0.95,
    "top_k": 64,
    "max_output_tokens": 8192,
    "response_mime_type": "text/plain"
  }
}
